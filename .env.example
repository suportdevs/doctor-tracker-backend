# Local development (npm run dev). Start MongoDB first: `docker compose up -d mongo` (port 27018).
MONGO_URI=mongodb://127.0.0.1:27018/doctor_tracker
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:3000
# Seed demo data automatically when the database is empty.
SEED_ON_START=true

# Email for password reset links and 2FA codes. Leave SMTP_HOST empty to run without email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Doctor Tracker <no-reply@doctortracker.dev>"
# Demo fallback: with no SMTP, show reset links / codes on screen. Set to false in production!
MAIL_PREVIEW=true
